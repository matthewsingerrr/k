{
  "name": "site-watcher-bot",
  "version": "1.0.0",
  "description": "Discord bot that watches websites 24/7 for redeploys, text changes, new pages, new subdomains and files.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "diff": "^9.0.0",
    "discord.js": "^14.27.0",
    "tldts": "^7.4.16",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^4.1.11"
  }
}
