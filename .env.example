# --- required ---
DISCORD_TOKEN=            # Bot token from https://discord.com/developers/applications → Bot → Reset Token

# --- optional ---
# DISCORD_GUILD_ID=       # Serve only this server (recommended): registers /watch there, leaves any other server
# DATA_DIR=/data          # Where the SQLite db lives. On Railway, attach a volume; its mount path is picked up automatically.
# CERTSPOTTER_API_KEY=    # Free key from sslmate.com/certspotter: your own CT quota (still 10 queries/hour) instead of the IP's shared one
# CERTSPOTTER_QUERIES_PER_HOUR=10  # Cert Spotter budget for the whole bot (free plan: 10)
# MAX_WATCHES_PER_GUILD=50         # Watches per Discord server (0 = no limit)
# DEFAULT_INTERVAL_SEC=2  # How often each site is checked (homepage, redeploys, uptime); min MIN_INTERVAL_SEC
# MIN_INTERVAL_SEC=1
# DEFAULT_SWEEP_SEC=120   # Every tracked page is re-checked at least this often
# DEFAULT_MAX_PAGES=150   # Pages per site whose text is tracked
# SUBDOMAIN_INTERVAL_SEC=300  # Cert Spotter poll cadence
# CRTSH_INTERVAL_SEC=1800     # crt.sh poll cadence (slow API)
# DNS_SCAN_INTERVAL_SEC=900   # DNS wordlist sweep cadence
# SITEMAP_INTERVAL_SEC=600
# GLOBAL_CONCURRENCY=16
# PER_HOST_CONCURRENCY=4
# REQUEST_TIMEOUT_MS=20000
# USER_AGENT=
# LOG_LEVEL=info          # debug | info | warn | error
